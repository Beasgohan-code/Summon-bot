# Telegram credentials
BOT_TOKEN=replace_with_botfather_token
OWNER_ID=replace_with_numeric_telegram_user_id
OWNER_PANEL_PASSWORD=replace_with_a_long_random_password
BOT_USERNAME=Summon_collection_bot
OWNER_USERNAME=og_gohan
SUPPORT_CHAT=https://t.me/summon_official
UPDATE_CHANNEL=https://t.me/Beastxgohan

# Asynchronous Telegram warning/error channel logging.
# The bot must be an administrator/member with permission to post.
LOGGER_ID=replace_with_log_channel_or_chat_id
LOG_LEVEL=INFO
LOG_TELEGRAM_LEVEL=WARNING
LOG_BATCH_SECONDS=1.5

# Durable production database.
DATABASE_URL=postgresql://username:password@host:5432/summon_bot

# Optional MongoDB settings reserved by the base project.
MONGO_URI=
MONGO_DB_NAME=summon_bot

# Public health and same-origin Mini App server.
PORT=8080
WEBAPP_ENABLED=true
KEEPALIVE_URL=https://summon-bot-wngc.onrender.com
KEEPALIVE_INTERVAL_SECONDS=300
KEEPALIVE_TIMEOUT_SECONDS=10
WATCHDOG_INTERVAL_SECONDS=60
WATCHDOG_TIMEOUT_SECONDS=180

# Process supervision. 0 = restart only after a crash (recommended).
AUTO_RESTART_MINUTES=0
RESTART_DELAY_SECONDS=10
